<?php

/**
 * @file
 * Hooks and theme registrations for the AI Metering module.
 */

use Drupal\ai_metering\Service\UsageExportService;
use Drupal\Core\Url;
use Drupal\user\UserInterface;
use Drupal\views\ViewExecutable;
use Symfony\Component\HttpFoundation\HeaderUtils;

/**
 * Implements hook_page_attachments().
 */
function ai_metering_page_attachments(array &$attachments): void {
  if (\Drupal::currentUser()->hasPermission('access toolbar')) {
    $attachments['#attached']['library'][] = 'ai_metering/ai_metering_toolbar';
  }

  $routeName = \Drupal::routeMatch()->getRouteName() ?? '';

  if ($routeName === 'view.ai_usage_log.dashboard') {
    $attachments['#attached']['library'][] = 'ai_metering/log_export_links';
  }

  if (!\Drupal::moduleHandler()->moduleExists('ai_translate')) {
    return;
  }

  if (!str_contains($routeName, 'content_translation_overview')) {
    return;
  }

  $attachments['#attached']['library'][] = 'ai_metering/ai_metering_estimate';
  $attachments['#attached']['drupalSettings']['aiMeteringEstimate'] = [
    'estimateUrl' => Url::fromRoute('ai_metering.token_estimate')->toString(),
  ];
}

