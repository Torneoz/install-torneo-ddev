<section class="torneo-modules" aria-labelledby="torneo-modules-title">
  <h2 id="torneo-modules-title" class="torneo-modules__title">AI modules included</h2>
  <p class="torneo-modules__intro">Enabled modules available immediately after rebuilding this stack.</p>
  <div class="torneo-modules__groups">
    {% for group_name, modules in groups %}
      <section class="torneo-modules__group">
        <h3>{{ group_name }}</h3>
        <ul>
          {% for module in modules %}
            <li>
              <a href="{{ module.url }}" rel="noopener noreferrer">{{ module.name }}</a>
              <span class="torneo-modules__version">{{ module.version }}</span>
              <code>{{ module.machine_name }}</code>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endfor %}
  </div>
</section>
