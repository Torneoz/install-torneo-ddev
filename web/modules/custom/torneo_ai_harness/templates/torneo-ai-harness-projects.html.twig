<section class="torneo-projects-section" aria-label="Torneo AI Projects in this stack">
  <div class="torneo-projects">
  {% for project in projects %}
    <article class="torneo-project">
      <div class="torneo-project__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          {% if project.icon == 'grok' %}
            <path d="M5 5l14 14M15.5 4H20v4.5M8.5 20H4v-4.5M7 12a5 5 0 0 1 5-5M17 12a5 5 0 0 1-5 5"/>
          {% elseif project.icon == 'language' %}
            <circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>
          {% elseif project.icon == 'image' %}
            <rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9" r="1.5"/><path d="M4 17l5-5 3.5 3.5 2-2L20 19"/>
          {% elseif project.icon == 'harness' %}
            <path d="M9 3h6M10 3v5l-5 9a2.5 2.5 0 0 0 2.2 4h9.6a2.5 2.5 0 0 0 2.2-4l-5-9V3M7.5 15h9"/>
          {% elseif project.icon == 'costs' %}
            <ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v5c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 11v5c0 1.7 3.1 3 7 3s7-1.3 7-3v-5"/>
          {% else %}
            <ellipse cx="12" cy="5" rx="7" ry="3"/><path d="M5 5v6c0 1.7 3.1 3 7 3s7-1.3 7-3V5M5 11v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/>
          {% endif %}
        </svg>
      </div>
      <h3 class="torneo-project__title">
        <a href="{{ project.main_url }}">{{ project.title }}</a>
      </h3>
      <div class="torneo-project__version">{{ project.version }}</div>
      <p class="torneo-project__description">{{ project.description }}</p>
      <footer class="torneo-project__footer">
        {% for link in project.links %}
          <a href="{{ link.url }}"{% if link.external %} rel="noopener noreferrer"{% endif %}>{{ link.label }}</a>
        {% endfor %}
      </footer>
    </article>
  {% endfor %}
  </div>
</section>
