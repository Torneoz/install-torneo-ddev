<?php

/**
 * @file
 * Theme hooks for the Torneo AI Harness module.
 */

/**
 * Implements hook_theme().
 */
function torneo_ai_harness_theme($existing, $type, $theme, $path): array {
  return [
    'torneo_ai_harness_projects' => [
      'variables' => [
        'projects' => [],
      ],
    ],
    'torneo_ai_harness_included_modules' => [
      'variables' => [
        'groups' => [],
      ],
    ],
  ];
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function torneo_ai_harness_form_ai_api_explorer_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  if (!isset($form['left']['pdf_ai_provider'], $form['left']['pdf_ajax_prefix'])) {
    return;
  }

  $provider_options = $form['left']['pdf_ai_provider']['#options'] ?? [];
  $selected_provider = (string) $form_state->getValue('pdf_ai_provider');
  $defaults = \Drupal::service('ai.provider')
    ->getDefaultProviderForOperationType('chat');
  if (\Drupal::request()->isMethod('GET')
    && isset($provider_options[$defaults['provider_id'] ?? ''])) {
    $selected_provider = (string) $defaults['provider_id'];
  }
  if (!isset($provider_options[$selected_provider])) {
    $selected_provider = (string) array_key_first($provider_options);
  }
  if ($selected_provider === '') {
    return;
  }

  $models = \Drupal::service('ai.provider')
    ->createInstance($selected_provider)
    ->getConfiguredModels('chat', [
      \Drupal\ai\Enum\AiModelCapability::ChatWithPdf,
    ]);
  $selected_model = (string) $form_state->getValue('pdf_ai_model');
  if (!isset($models[$selected_model])) {
    $default_model = $selected_provider === ($defaults['provider_id'] ?? NULL)
      ? (string) ($defaults['model_id'] ?? '')
      : '';
    $selected_model = isset($models[$default_model])
      ? $default_model
      : (string) array_key_first($models);
  }

  $form_state->setValue('pdf_ai_provider', $selected_provider);
  $form_state->setValue('pdf_ai_model', $selected_model);
  $form['left']['pdf_ai_provider']['#default_value'] = $selected_provider;
  // Changing providers rebuilds the model selector. Do not validate the stale
  // model value or the rest of the investigation form during that AJAX pass.
  $form['left']['pdf_ai_provider']['#limit_validation_errors'] = [];
  if (isset($form['left']['pdf_ajax_prefix']['pdf_ai_model'])) {
    $form['left']['pdf_ajax_prefix']['pdf_ai_model']['#options'] = $models;
    $form['left']['pdf_ajax_prefix']['pdf_ai_model']['#default_value'] = $selected_model;
  }
}
